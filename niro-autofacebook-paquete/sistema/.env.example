# El perfil persistente es EXCLUSIVO para esta prueba. No apuntar al perfil
# habitual de Chrome ni compartir esta carpeta.
NIRO_PORT=8787
NIRO_HOST=127.0.0.1
NIRO_BROWSER_PROFILE=./data/browser-profile
# Archivo JSON: base principal si NIRO_DATABASE_URL está vacío; con PostgreSQL
# solo se usa para la importación inicial y como copia de emergencia.
NIRO_DATABASE=./data/niro.json
# PostgreSQL (recomendado). La primera vez importa automáticamente el JSON.
NIRO_DATABASE_URL=postgres://postgres:postgres@localhost:5432/autofacebook
NIRO_POLL_SECONDS=60
NIRO_SCHEDULE_SECONDS=15
NIRO_SCHEDULER_AUTOSTART=false
# Límites de sincronización profunda; aumentar solo si la cuenta lo necesita.
NIRO_MAX_CHATS=500
NIRO_CHAT_HISTORY_PAGES=30
NIRO_MAX_CHAT_MESSAGES=5000
# Rondas de desplazamiento al descargar publicaciones de cada perfil/página/grupo.
NIRO_POST_SCROLLS=12
# Opcional; por defecto intenta Chrome/Edge instalados en Windows.
NIRO_BROWSER_EXECUTABLE=
# Opcional: endpoint local de Niro que reciba {source,text,url,externalId}
# y devuelva {"draft":"..."}. Si queda vacío, se usa una plantilla segura.
NIRO_DRAFT_WEBHOOK=
# --- Producción / acceso remoto ---
# Contraseña del panel. Obligatoria si NIRO_HOST no es 127.0.0.1.
NIRO_PANEL_PASSWORD=
# Secreto para firmar la sesión (cadena larga aleatoria). Si queda vacío se deriva de la contraseña.
NIRO_SESSION_SECRET=
# Dominios o IPs con los que se accede al panel, separados por coma (ej: niro.midominio.com).
NIRO_ALLOWED_HOSTS=
# Diagnóstico de selectores de Facebook (solo desarrollo).
NIRO_DEBUG=false
# --- Respuestas con IA (https://niro.cnid.com.py/docs) ---
NIRO_AI_API_URL=https://niro.cnid.com.py/api/v1
# API Key de Niro (empieza con niro_). No la subas a repositorios.
NIRO_AI_API_KEY=
# --- Navegador ---
# true = Chrome trabaja en segundo plano, sin ventana (se cambia desde Datos).
NIRO_HEADLESS=true
# --- CRM: formularios de anuncios (webhooks) ---
# Vacías = webhook cerrado. El panel tiene que estar publicado con HTTPS.
# Meta Lead Ads: token de verificación de la suscripción y secreto de la app (firma).
NIRO_META_VERIFY_TOKEN=
NIRO_META_APP_SECRET=
# Token de la página para leer los datos de cada formulario (Graph API).
NIRO_META_PAGE_TOKEN=
NIRO_META_GRAPH_VERSION=v23.0
# Google Ads: la clave que se carga en el formulario de clientes potenciales.
NIRO_GOOGLE_LEAD_KEY=
# Formulario web propio (cabecera x-niro-token).
NIRO_WEB_FORM_TOKEN=
