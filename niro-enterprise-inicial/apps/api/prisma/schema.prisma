generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  OWNER
  ADMIN
  SUPERVISOR
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  NOTE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum CallCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CallRecipientStatus {
  PENDING
  QUEUED
  STARTING
  RINGING
  CONNECTED
  PLAYING
  COMPLETED
  NO_ANSWER
  FAILED
  CANCELLED
  RETRY_PENDING
}

model Organization {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  active        Boolean               @default(true)
  planTier      String                @default("basic")
  maxUsers      Int                   @default(20)
  trialEndsAt   DateTime?
  paidUntil     DateTime?
  billingExempt Boolean               @default(false)
  planId        String?
  plan          Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  billingPayments BillingPayment[]
  platformNotices PlatformNotice[]
  quickReplies  QuickReply[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  users         User[]
  departments   Department[]
  contacts      Contact[]
  conversations Conversation[]
  orders        Order[]
  attachments   Attachment[]
  settings      OrganizationSettings?
  campaigns     Campaign[]
  callAccounts  CallAccount[]
  callAudios    CallAudio[]
  callCampaigns CallCampaign[]
  callDirectRecords CallDirectRecord[]
  callEvents    CallEvent[]
  callAuditLogs CallAuditLog[]
  webhooks              ApiWebhook[]
  apiKeys       ApiKey[]
  aiUsageLogs   AiUsageLog[]
  whatsappStatuses WhatsappStatus[]
  whatsappGroups WhatsappGroup[]
  whatsappSyncJobs WhatsappSyncJob[]
  statusPosts   WhatsappStatusPost[]
  statusCampaigns WhatsappStatusCampaign[]
  outcomeCategories OutcomeCategory[]
  outcomes          ConversationOutcome[]
  statusViews       WhatsappStatusView[]
  // SMS prepago: cada crédito es un SMS. El saldo se mueve solo con SmsTransaction (compras, envíos, ajustes).
  smsBalance        Int    @default(0)
  smsTransactions   SmsTransaction[]
  smsPurchases      SmsPurchase[]
  smsCampaigns      SmsCampaign[]
  smsMessages       SmsMessage[]
}

model OrganizationSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  systemPrompt   String       @default("")
  welcomeMessage String       @default("¡Hola! ¿En qué podemos ayudarte?")
  aiEnabled      Boolean      @default(false)
  menuOptions    Json         @default("[]")
  botFlow        Json         @default("{}")
  autoTranscribeAudio Boolean @default(false)
  syncGroupsEnabled         Boolean @default(false)
  syncContactsEnabled       Boolean @default(false)
  syncMessageHistoryEnabled Boolean @default(false)
  syncAvatarsEnabled        Boolean @default(false)
  syncStatusesEnabled       Boolean @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model User {
  id                 String             @id @default(cuid())
  organizationId     String?
  name               String
  email              String             @unique
  // Para mandarle por WhatsApp la bienvenida con sus datos de acceso al crearlo (opcional).
  phone              String?
  passwordHash       String
  role               UserRole           @default(AGENT)
  active             Boolean            @default(true)
  mustChangePassword Boolean            @default(false)
  createdAt          DateTime           @default(now())
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships        DepartmentMember[]
  assigned           Conversation[]     @relation("AssignedAgent")
  messages           Message[]
  refreshTokens      RefreshToken[]
  assignedOrders     Order[]            @relation("AssignedOrders")
  campaigns          Campaign[]
  callCampaigns      CallCampaign[]       @relation("CallCampaignCreator")
  callAudios         CallAudio[]          @relation("CallAudioCreator")
  callAccounts       CallAccount[]        @relation("CallAccountCreator")
  callDirectRecords  CallDirectRecord[]   @relation("CallDirectRecordCreator")
  apiKeys            ApiKey[]
  pushSubscriptions  PushSubscription[]
  permissions        Json?
  quickReplies       QuickReply[]
  conversationReads  ConversationRead[]
  // Auto chat: los chats nuevos sin asignar le llegan solos (sin que un administrador se los transfiera).
  autoChat           Boolean            @default(false)
  outcomes           ConversationOutcome[] @relation("OutcomeAgent")
  callSurveyOptions  CallSurveyOption[]
}

model Department {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        DepartmentMember[]
  conversations  Conversation[]
  surveyOptions  CallSurveyOption[]

  @@unique([organizationId, name])
}

model DepartmentMember {
  id           String     @id @default(cuid())
  departmentId String
  userId       String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
}

model Contact {
  id                 String              @id @default(cuid())
  organizationId     String
  name               String?
  phone              String?
  email              String?
  externalId         String?
  avatarUrl          String?
  tags               String[]            @default([])
  createdAt          DateTime            @default(now())
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  orders             Order[]
  campaignRecipients CampaignRecipient[]
  callCampaignRecipients CallCampaignRecipient[]
  callSurveyResponses CallSurveyResponse[]
  directCallRecords CallDirectRecord[]
  whatsappStatuses WhatsappStatus[]
  outcomes ConversationOutcome[]
  callConsentStatus String? @default("UNKNOWN")
  callConsentAt DateTime?
  callConsentSource String?
  callOptedOutAt DateTime?
  callOptOutSource String?

  @@index([organizationId, phone])
  @@index([tags], type: Gin)
  @@index([organizationId, callConsentStatus, callOptedOutAt])
}

model Conversation {
  id             String               @id @default(cuid())
  organizationId String
  contactId      String
  departmentId   String?
  assignedToId   String?
  subject        String?
  status         ConversationStatus   @default(OPEN)
  priority       ConversationPriority @default(NORMAL)
  channel        String               @default("web")
  widgetToken    String?              @unique
  tags           String[]             @default([])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedTo     User?                @relation("AssignedAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages       Message[]
  orders         Order[]
  directCallRecords CallDirectRecord[]
  outcomes       ConversationOutcome[]

  @@index([organizationId, status, updatedAt])
  @@index([tags], type: Gin)
  reads          ConversationRead[]
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  senderUserId    String?
  direction       MessageDirection
  content         String           @db.Text
  contentType     String           @default("text")
  deliveryStatus  String           @default("sent")
  senderKind      String?
  waMessageId     String?
  imported        Boolean          @default(false)
  campaignId      String?
  apiKeyId        String?
  quotedMessageId String?
  quotedPreview   String?
  quotedSender    String?
  transcription   String?          @db.Text
  reactions       Json             @default("[]")
  // Nota interna que solo ve la administración (propietario/admin/supervisor), no los agentes. Ej.: "X aceptó la transferencia".
  staffOnly       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  apiKey          ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  sender          User?            @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  attachment      Attachment?

  @@index([conversationId, createdAt])
  @@index([conversationId, waMessageId])
  @@index([campaignId, createdAt])
  @@index([apiKeyId, createdAt])
}

model Attachment {
  id             String       @id @default(cuid())
  organizationId String
  messageId      String?      @unique
  fileName       String
  mimeType       String
  size           Int
  storageKey     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  campaign       Campaign?

  @@index([organizationId])
}

model Campaign {
  id              String              @id @default(cuid())
  organizationId  String
  name            String
  message         String              @db.Text
  attachmentId    String?             @unique
  tagFilter       String[]            @default([])
  sendLine        String?
  campaignType    String              @default("DIRECT")
  speedProfile    String              @default("BALANCED")
  messagesPerHour Int                 @default(40)
  ratePerMinute   Int                 @default(20)
  status          CampaignStatus      @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attachment      Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients      CampaignRecipient[]
  messages        Message[]

  @@index([organizationId, status, createdAt])
}

model CampaignRecipient {
  id           String                  @id @default(cuid())
  campaignId   String
  contactId    String?
  groupJid     String?
  groupName    String?
  displayName  String? // nombre pegado en la lista de la campaña: manda sobre el del contacto al personalizar
  status       CampaignRecipientStatus @default(PENDING)
  waMessageId  String?
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime                @default(now())
  campaign     Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact?                @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@unique([campaignId, groupJid])
  @@index([campaignId, status])
  @@index([waMessageId])
}

model CallAccount {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  phoneNumber     String?
  status          String   @default("DISCONNECTED")
  sessionReference String?
  lastError       String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("CallAccountCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campaigns       CallCampaign[]
  attempts        CallAttempt[]
  directCallRecords CallDirectRecord[]

  @@index([organizationId, status, updatedAt])
}

model CallAudio {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  storageKey      String
  mimeType        String
  size            Int
  durationSeconds Int?
  processingStatus String  @default("READY")
  source          String  @default("UPLOAD")
  provider        String?
  voice           String?
  language        String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("CallAudioCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  campaigns       CallCampaign[]
  attempts        CallAttempt[]

  @@index([organizationId, processingStatus, createdAt])
}

model CallCampaign {
  id                    String            @id @default(cuid())
  organizationId        String
  name                  String
  description           String?
  campaignType          String            @default("COMMERCIAL")
  accountId             String
  audioId               String
  status                CallCampaignStatus @default(DRAFT)
  scheduledAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  timezone              String            @default("America/Asuncion")
  maxConcurrent         Int               @default(1)
  pauseBetweenSeconds   Int               @default(10)
  maxAttempts           Int               @default(1)
  answerTimeoutSeconds  Int               @default(30)
  retryDelaySeconds     Int               @default(300)
  allowedFrom           String?
  allowedTo             String?
  surveyEnabled         Boolean           @default(false)
  surveyQuestion        String?
  surveyResponseMethod   String            @default("WHATSAPP")
  surveyExpiresAt       DateTime?
  createdByUserId       String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account               CallAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  audio                 CallAudio         @relation(fields: [audioId], references: [id], onDelete: Restrict)
  createdBy             User?             @relation("CallCampaignCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients            CallCampaignRecipient[]
  attempts              CallAttempt[]
  survey                CallSurvey?
  surveyResponses       CallSurveyResponse[]
  events                CallEvent[]
  auditLogs             CallAuditLog[]

  @@index([organizationId, status, createdAt])
  @@index([accountId, status])
}

model CallCampaignRecipient {
  id              String             @id @default(cuid())
  campaignId      String
  contactId       String
  phoneNumber     String
  status          CallRecipientStatus @default(PENDING)
  attemptCount    Int                @default(0)
  lastAttemptAt   DateTime?
  nextAttemptAt   DateTime?
  finalResult     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  campaign        CallCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact         Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  attempts        CallAttempt[]

  @@unique([campaignId, contactId])
  @@index([campaignId, status, nextAttemptAt])
  @@index([contactId])
}

model CallAttempt {
  id                 String             @id @default(cuid())
  campaignId         String
  campaignContactId  String
  accountId          String
  audioId            String?
  attemptNumber      Int
  status             CallRecipientStatus @default(STARTING)
  callId             String?
  startedAt          DateTime           @default(now())
  answeredAt         DateTime?
  finishedAt         DateTime?
  durationSeconds    Int?
  errorCode          String?
  errorMessage       String?
  providerEventData  Json?
  createdAt          DateTime           @default(now())
  campaign           CallCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignContact    CallCampaignRecipient @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  account            CallAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  audio              CallAudio?         @relation(fields: [audioId], references: [id], onDelete: SetNull)
  surveyResponses    CallSurveyResponse[]
  events             CallEvent[]

  @@index([campaignId, createdAt])
  @@index([campaignContactId, attemptNumber])
  @@index([callId])
}

model CallDirectRecord {
  id                String              @id @default(cuid())
  organizationId    String
  accountId         String
  contactId         String?
  conversationId    String?
  createdByUserId   String?
  phoneNumber       String
  status            CallRecipientStatus @default(STARTING)
  callId            String?
  startedAt         DateTime            @default(now())
  answeredAt        DateTime?
  finishedAt        DateTime?
  durationSeconds   Int?
  endedReason       String?
  errorCode         String?
  errorMessage      String?
  providerEventData Json?
  createdAt         DateTime            @default(now())
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account           CallAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contact           Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation      Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("CallDirectRecordCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([contactId, createdAt])
  @@index([callId])
}

model CallSurvey {
  id             String   @id @default(cuid())
  campaignId     String   @unique
  question       String
  responseMethod String   @default("WHATSAPP")
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  campaign       CallCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  options        CallSurveyOption[]
  responses      CallSurveyResponse[]
}

model CallSurveyOption {
  id           String      @id @default(cuid())
  surveyId     String
  optionKey    String
  optionLabel  String
  replyMessage String?
  action       String      @default("AUTO")
  crmStage     String?
  // Igual que el menú del bot de WhatsApp: si se elige un área o un agente, el chat se deriva al aceptar la opción.
  departmentId String?
  userId       String?
  survey       CallSurvey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([surveyId, optionKey])
}

model CallSurveyResponse {
  id              String   @id @default(cuid())
  surveyId        String
  campaignId      String
  contactId       String
  attemptId       String?
  responseValue   String
  responseChannel String
  status          String   @default("RESPONDED")
  respondedAt     DateTime @default(now())
  survey          CallSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  campaign        CallCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact         Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  attempt         CallAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([campaignId, respondedAt])
  @@index([contactId, respondedAt])
}

model CallEvent {
  id          String   @id @default(cuid())
  organizationId String
  campaignId  String
  attemptId   String?
  eventType   String
  eventPayload Json?
  createdAt   DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign    CallCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  attempt     CallAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([campaignId, createdAt])
}

model CallAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  details        Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       CallCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([campaignId, createdAt])
}

model ApiKey {
  id              String       @id @default(cuid())
  organizationId  String
  createdByUserId String?
  name            String
  keyPrefix       String
  keyHash         String       @unique
  scopes          String[]     @default(["messages:send"])
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages        Message[]
  webhooks        ApiWebhook[]

  @@index([organizationId, revokedAt, createdAt])
}

// Un registro por llamada exitosa a la API de Niro IA (chat del bot, agentes propios,
// transcripción de audio, OCR/visión, análisis de documentos). `cost` es lo que devuelve esa
// API en el momento — sin garantía de unidad estable entre categorías (algunas respuestas traen
// decimales pequeños, otras enteros grandes); se guarda tal cual para no inventar una conversión,
// y la interfaz lo muestra desglosado por tipo en lugar de sumarlo a ciegas.
model AiUsageLog {
  id             String       @id @default(cuid())
  organizationId String
  kind           String
  cost           Decimal?     @db.Decimal(14, 4)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Order {
  id             String        @id @default(cuid())
  organizationId String
  contactId      String
  conversationId String?
  assignedToId   String?
  status         OrderStatus   @default(RECEIVED)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedTo     User?         @relation("AssignedOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([organizationId, status, updatedAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  name      String
  quantity  Int      @default(1)
  unitPrice Decimal? @db.Decimal(12, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Webhooks de la API pública: a dónde avisar cuando entra un mensaje, cambia su estado o se actualiza un chat.
model ApiWebhook {
  id             String       @id @default(cuid())
  organizationId String
  apiKeyId       String?
  url            String
  secret         String
  events         String[]     @default([])
  active         Boolean      @default(true)
  lastStatus     Int?
  lastError      String?
  lastDeliveryAt DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey         ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, active])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  userAgent      String?
  ip             String?
  // Sesión prestada: superadmin que entró como este usuario desde el panel (soporte). Null = sesión normal.
  impersonatorId String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Una suscripción Web Push (VAPID) por dispositivo/navegador que un usuario autorizó. Un mismo
// usuario puede tener varias (celular, PC del trabajo, etc.); se identifican por `endpoint`,
// que el navegador genera único por combinación de sitio + dispositivo.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "Estados" (stories) que los contactos publican en WhatsApp. Duran 24 h: se guardan para
// mostrarlos en la bandeja y se eliminan al vencer.
model WhatsappStatus {
  id              String       @id @default(cuid())
  organizationId  String
  contactId       String?
  participantJid  String
  phone           String?
  displayName     String?
  waMessageId     String
  kind            String
  text            String?
  caption         String?
  backgroundColor String?
  mimeType        String?
  storageKey      String?
  fromMe          Boolean      @default(false)
  postedAt        DateTime
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([organizationId, waMessageId])
  @@index([organizationId, expiresAt])
}

// Estados que la organización publica desde Nirobot (texto o imagen), inmediatos o programados.
// La cola vive en esta tabla: un worker reclama de forma atómica las publicaciones vencidas.
model WhatsappStatusPost {
  id                 String       @id @default(cuid())
  organizationId     String
  createdByUserId    String?
  contentType        String
  textContent        String?
  caption            String?
  mediaStorageKey    String?
  mimeType           String?
  backgroundColor    String?
  fontStyle          Int?
  audienceType       String
  audienceTags       String[]     @default([])
  audienceContactIds String[]     @default([])
  audienceCount      Int          @default(0)
  publicationMode    String
  scheduledAt        DateTime?
  publishedAt        DateTime?
  expiresAt          DateTime?
  status             String
  nextAttemptAt      DateTime?
  waMessageId        String?
  errorMessage       String?
  retryCount         Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId         String?
  sequence           Int?
  attempts           WhatsappStatusAttempt[]
  campaign           WhatsappStatusCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([campaignId, sequence])
}

// Campaña de estados: una serie de publicaciones que salen solas cada N horas.
// Cada ítem es un WhatsappStatusPost programado; pausar la campaña detiene al worker.
model WhatsappStatusCampaign {
  id               String       @id @default(cuid())
  organizationId   String
  createdByUserId  String?
  name             String
  intervalHours    Int
  startAt          DateTime
  replacePrevious  Boolean      @default(false)
  status           String       @default("active")
  totalItems       Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts            WhatsappStatusPost[]

  @@index([organizationId, status])
}

model WhatsappStatusAttempt {
  id            String             @id @default(cuid())
  postId        String
  attemptNumber Int
  startedAt     DateTime           @default(now())
  finishedAt    DateTime?
  successful    Boolean            @default(false)
  errorMessage  String?
  post          WhatsappStatusPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}


// Cobro del plan mensual (Winsap: link de pago con tarjeta / QR Bancard).
model BillingPayment {
  id              String       @id @default(cuid())
  organizationId  String
  amount          Int
  currency        String       @default("PYG")
  periodDays      Int          @default(30)
  status          String       @default("pending") // pending | paid | failed | expired
  winsapLinkId    String?
  winsapLinkToken String?
  paymentUrl      String?
  winsapPaymentId String?
  paymentMethod   String?
  planId          String?
  planName        String?
  paidAt          DateTime?
  raw             Json?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status])
}

// Avisos del superadmin hacia los clientes. audience: all | trial | active | expired | org
model PlatformNotice {
  id             String               @id @default(cuid())
  audience       String               @default("all")
  organizationId String?
  title          String
  body           String               @db.Text
  level          String               @default("info") // info | warning | success
  createdByUserId String?
  createdAt      DateTime             @default(now())
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reads          PlatformNoticeRead[]

  @@index([createdAt])
}

model PlatformNoticeRead {
  id       String         @id @default(cuid())
  noticeId String
  userId   String
  readAt   DateTime       @default(now())
  notice   PlatformNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
}


// Planes de suscripción (editables desde el superadmin). maxAgents = agentes ADEMÁS del propietario.
model Plan {
  id          String         @id @default(cuid())
  name        String
  description String?
  priceGs     Int
  maxAgents   Int
  features    String[]       @default([])
  active      Boolean        @default(true)
  popular     Boolean        @default(false)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  organizations Organization[]
}


// Respuestas rápidas del chat: se despliegan escribiendo "/" y el atajo.
model QuickReply {
  id              String       @id @default(cuid())
  organizationId  String
  shortcut        String
  title           String
  content         String       @db.Text
  shared          Boolean      @default(true)
  createdByUserId String?
  usageCount      Int          @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, shortcut])
  @@index([organizationId, usageCount])
}


// Hasta cuándo leyó cada usuario cada conversación (mensajes entrantes posteriores = no leídos).
model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// Categorías de gestión que crea cada empresa (venta cerrada, venta perdida, cotización enviada…).
// kind resume el resultado para las estadísticas: WON (venta), LOST (venta perdida), QUOTE (cotización), OTHER.
model OutcomeCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  kind           String   @default("OTHER")
  requiresAmount Boolean  @default(false)
  color          String   @default("#64748b")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outcomes       ConversationOutcome[]

  @@unique([organizationId, name])
  @@index([organizationId, active, sortOrder])
}

// Gestión registrada por un agente sobre una conversación: cierre (con o sin venta) o avance (p. ej. cotización enviada).
// Guarda copia del nombre de la categoría y del agente para que el historial no cambie si luego se renombran o borran.
model ConversationOutcome {
  id                 String   @id @default(cuid())
  organizationId     String
  conversationId     String
  contactId          String?
  agentId            String?
  agentName          String
  categoryId         String?
  categoryName       String
  kind               String   @default("OTHER")
  amount             Decimal? @db.Decimal(14, 2)
  note               String?
  closedConversation Boolean  @default(false)
  createdAt          DateTime @default(now())
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation       Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact            Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  agent              User?            @relation("OutcomeAgent", fields: [agentId], references: [id], onDelete: SetNull)
  category           OutcomeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, agentId, createdAt])
  @@index([conversationId])
}

// Quién vio (y quién reaccionó a) un estado que publicó la empresa. waMessageId es el id del estado propio en WhatsApp,
// así sirve para los publicados desde Nirobot y para los subidos desde el teléfono. Solo hay datos de quienes
// tienen activadas las confirmaciones de lectura: WhatsApp no informa las vistas de los demás.
model WhatsappStatusView {
  id             String    @id @default(cuid())
  organizationId String
  waMessageId    String
  viewerJid      String
  phone          String?
  displayName    String?
  contactId      String?
  viewedAt       DateTime?
  reaction       String?
  reactedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, waMessageId, viewerJid])
  @@index([organizationId, waMessageId])
}

// Libro de saldo SMS: type = PURCHASE | CONSUMPTION | REFUND | ADJUSTMENT. amount es con signo (+ suma, - resta).
model SmsTransaction {
  id              String   @id @default(cuid())
  organizationId  String
  type            String
  amount          Int
  balanceAfter    Int
  note            String?
  reference       String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Recarga de saldo. source = CARD (pago en línea con Winsap) | ADMIN (asignada por el superadmin).
model SmsPurchase {
  id              String   @id @default(cuid())
  organizationId  String
  credits         Int
  unitPrice       Int
  amount          Int
  status          String   @default("pending") // pending | paid | failed | expired
  source          String   @default("CARD")
  winsapLinkId    String?
  winsapLinkToken String?
  paymentUrl      String?
  winsapPaymentId String?
  paymentMethod   String?
  note            String?
  createdByUserId String?
  paidAt          DateTime?
  raw             Json?
  createdAt       DateTime @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status])
}

model SmsCampaign {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  message          String   @db.Text
  stripAccents     Boolean  @default(true)
  source           String   @default("CAMPAIGN") // CAMPAIGN | QUICK
  status           String   @default("DRAFT")    // DRAFT | SCHEDULED | SENDING | PAUSED | COMPLETED | CANCELLED
  pauseReason      String?
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages         SmsMessage[]

  @@index([organizationId, status, createdAt])
}

// Un SMS a un destinatario. Guarda el texto ya personalizado tal como se envió.
model SmsMessage {
  id                String   @id @default(cuid())
  organizationId    String
  campaignId        String?
  contactId         String?
  name              String?
  phone             String
  body              String   @db.Text
  encoding          String   @default("gsm7")
  status            String   @default("PENDING") // PENDING | SENDING | SENT | DELIVERED | FAILED | CANCELLED
  providerMessageId String?
  errorMessage      String?
  credits           Int      @default(1)
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign          SmsCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([campaignId, status])
  @@index([providerMessageId])
}

// Grupos de WhatsApp de la cuenta conectada (se descargan al conectar y con "Sincronizar").
model WhatsappGroup {
  id             String   @id @default(cuid())
  organizationId String
  jid            String
  name           String
  description    String?
  ownerJid       String?
  ownerPhone     String?
  groupCreatedAt DateTime?
  announce       Boolean  @default(false)
  avatarUrl      String?
  size           Int      @default(0)
  syncedAt       DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        WhatsappGroupMember[]

  @@unique([organizationId, jid])
  @@index([organizationId, name])
}

model WhatsappGroupMember {
  id       String  @id @default(cuid())
  groupId  String
  jid      String
  lid      String?
  phone    String?
  name     String?
  avatarUrl String?
  role     String?
  isSelf   Boolean @default(false)
  group    WhatsappGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, jid])
  @@index([groupId])
}

// Trabajos de importación desde WhatsApp (grupos, contactos, historial, avatares, estados).
model WhatsappSyncJob {
  id                String    @id @default(cuid())
  organizationId    String
  type              String
  status            String    @default("PROCESSING")
  total             Int       @default(0)
  processed         Int       @default(0)
  failed            Int       @default(0)
  detail            Json?
  message           String?
  requestedByUserId String?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, startedAt])
}
