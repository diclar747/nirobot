generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  OWNER
  ADMIN
  SUPERVISOR
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  NOTE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Organization {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  active        Boolean               @default(true)
  planTier      String                @default("basic")
  maxUsers      Int                   @default(20)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  users         User[]
  departments   Department[]
  contacts      Contact[]
  conversations Conversation[]
  orders        Order[]
  attachments   Attachment[]
  settings      OrganizationSettings?
  campaigns     Campaign[]
  apiKeys       ApiKey[]
}

model OrganizationSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  systemPrompt   String       @default("")
  welcomeMessage String       @default("¡Hola! ¿En qué podemos ayudarte?")
  aiEnabled      Boolean      @default(false)
  menuOptions    Json         @default("[]")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model User {
  id                 String             @id @default(cuid())
  organizationId     String?
  name               String
  email              String             @unique
  passwordHash       String
  role               UserRole           @default(AGENT)
  active             Boolean            @default(true)
  mustChangePassword Boolean            @default(false)
  createdAt          DateTime           @default(now())
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships        DepartmentMember[]
  assigned           Conversation[]     @relation("AssignedAgent")
  messages           Message[]
  refreshTokens      RefreshToken[]
  assignedOrders     Order[]            @relation("AssignedOrders")
  campaigns          Campaign[]
  apiKeys            ApiKey[]
}

model Department {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        DepartmentMember[]
  conversations  Conversation[]

  @@unique([organizationId, name])
}

model DepartmentMember {
  id           String     @id @default(cuid())
  departmentId String
  userId       String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
}

model Contact {
  id                 String              @id @default(cuid())
  organizationId     String
  name               String?
  phone              String?
  email              String?
  externalId         String?
  avatarUrl          String?
  tags               String[]            @default([])
  createdAt          DateTime            @default(now())
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  orders             Order[]
  campaignRecipients CampaignRecipient[]

  @@index([organizationId, phone])
  @@index([tags], type: Gin)
}

model Conversation {
  id             String               @id @default(cuid())
  organizationId String
  contactId      String
  departmentId   String?
  assignedToId   String?
  subject        String?
  status         ConversationStatus   @default(OPEN)
  priority       ConversationPriority @default(NORMAL)
  channel        String               @default("web")
  widgetToken    String?              @unique
  tags           String[]             @default([])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedTo     User?                @relation("AssignedAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages       Message[]
  orders         Order[]

  @@index([organizationId, status, updatedAt])
  @@index([tags], type: Gin)
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  senderUserId    String?
  direction       MessageDirection
  content         String           @db.Text
  contentType     String           @default("text")
  deliveryStatus  String           @default("sent")
  waMessageId     String?
  campaignId      String?
  apiKeyId        String?
  quotedMessageId String?
  quotedPreview   String?
  quotedSender    String?
  transcription   String?          @db.Text
  reactions       Json             @default("[]")
  createdAt       DateTime         @default(now())
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  apiKey          ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  sender          User?            @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  attachment      Attachment?

  @@index([conversationId, createdAt])
  @@index([conversationId, waMessageId])
  @@index([campaignId, createdAt])
  @@index([apiKeyId, createdAt])
}

model Attachment {
  id             String       @id @default(cuid())
  organizationId String
  messageId      String?      @unique
  fileName       String
  mimeType       String
  size           Int
  storageKey     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  campaign       Campaign?

  @@index([organizationId])
}

model Campaign {
  id              String              @id @default(cuid())
  organizationId  String
  name            String
  message         String              @db.Text
  attachmentId    String?             @unique
  tagFilter       String[]            @default([])
  sendLine        String?
  campaignType    String              @default("DIRECT")
  speedProfile    String              @default("BALANCED")
  messagesPerHour Int                 @default(40)
  ratePerMinute   Int                 @default(20)
  status          CampaignStatus      @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attachment      Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients      CampaignRecipient[]
  messages        Message[]

  @@index([organizationId, status, createdAt])
}

model CampaignRecipient {
  id           String                  @id @default(cuid())
  campaignId   String
  contactId    String
  status       CampaignRecipientStatus @default(PENDING)
  waMessageId  String?
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime                @default(now())
  campaign     Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([waMessageId])
}

model ApiKey {
  id              String       @id @default(cuid())
  organizationId  String
  createdByUserId String?
  name            String
  keyPrefix       String
  keyHash         String       @unique
  scopes          String[]     @default(["messages:send"])
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([organizationId, revokedAt, createdAt])
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Order {
  id             String        @id @default(cuid())
  organizationId String
  contactId      String
  conversationId String?
  assignedToId   String?
  status         OrderStatus   @default(RECEIVED)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedTo     User?         @relation("AssignedOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([organizationId, status, updatedAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  name      String
  quantity  Int      @default(1)
  unitPrice Decimal? @db.Decimal(12, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  userAgent      String?
  ip             String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
