# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS Y ENTORNO
# ==========================================
POSTGRES_DB=niro
POSTGRES_USER=niro
POSTGRES_PASSWORD=niro_secure_password_2026
DATABASE_URL=postgresql://niro:niro_secure_password_2026@db:5432/niro?schema=public
JWT_SECRET=niro_enterprise_super_secret_jwt_key_2026_x89a

API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# ==========================================
# WHATSAPP Y CAMPAÑAS DE LLAMADAS
# ==========================================
# mock prueba el ciclo de campañas sin llamar a nadie. Para llamadas reales,
# instalar el proveedor opcional y ffmpeg; ver apps/api/docs/WHATSAPP_CALLS.md.
WHATSAPP_CALL_PROVIDER=mock
# Para llamadas reales en Windows local: ruta absoluta al ejecutable descargado de FFmpeg.
# En Docker no hace falta: la imagen instala ffmpeg automáticamente.
# FFMPEG_PATH=D:\\ruta\\al\\proyecto\\.local\\ffmpeg\\bin\\ffmpeg.exe
WHATSAPP_RESUME_SESSIONS=true
WHATSAPP_SESSION_ROOT=./storage/whatsapp-sessions

# ==========================================
# USUARIO SUPERADMIN POR DEFECTO
# ==========================================
SEED_SUPERADMIN_EMAIL=superadmin@niro.com
SEED_SUPERADMIN_PASSWORD=Password123!

# ==========================================
# API DE NIRO IA (https://niro.cnid.com.py/docs)
# Chat del bot de WhatsApp/widget, transcripción de audio, OCR de facturas y agentes propios.
# Generá tu API key en /api-keys dentro de esa plataforma. Sin esta variable, el bot de IA
# queda apagado en todo el sistema (nada se rompe, simplemente no responde).
# ==========================================
NIRO_AI_BASE_URL=https://niro.cnid.com.py
NIRO_AI_API_KEY=
# La documentación pública actual de Niro IA expone transcripción, no TTS. Si tu cuenta
# tiene voz habilitada, indicá el endpoint real que te entregue Niro:
# CALL_TTS_PROVIDER=niro
# NIRO_AI_TTS_PATH=/api/v1/audio/speech
# NIRO_AI_TTS_MODEL=
# NIRO_AI_TTS_VOICE=
# Alternativa compatible con OpenAI TTS:
# CALL_TTS_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# ==========================================
# NOTIFICACIONES PUSH (Web Push / VAPID)
# Alertan al equipo de mensajes nuevos y transferencias sin depender de tener la pestaña abierta.
# Generá tu propio par de claves (gratis, sin servicio externo):
#   cd apps/api && node -e "console.log(require('web-push').generateVAPIDKeys())"
# Sin estas variables, la campanita de notificaciones queda oculta (nada se rompe).
# ==========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@tuempresa.com
